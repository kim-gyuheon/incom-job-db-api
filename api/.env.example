# 음성 답변 키워드 추출(G만 해당, C/D/E/F는 규칙 기반) / 추천 이유 생성 보조용. 선택사항 —
# 없어도 표현 사전 기반 규칙 매칭으로 동작한다. 비용 정책상 운영 배포에는 기본적으로 안 넣음
# (요청당 과금이라 실사용 붙으면 비용이 커짐).
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 음성 -> 텍스트 변환 공급자.
#   local  : faster-whisper를 같은 프로세스에서 직접 실행 (권장 — 요청당 과금 없음, 비용
#            정책상 기본 운영 방식). 로컬 개발 시 첫 요청에서 모델을 다운로드하니 시간이
#            좀 걸릴 수 있다.
#   openai : OPENAI_API_KEY로 Whisper 전사 API 호출 (요청당 과금 — local이 메모리 제약 등으로
#            안 될 때만 쓰는 대안)
#   mock   : 고정 문장 반환. 마이크/과금 없이 세 엔드포인트 흐름을 테스트할 때.
# 미설정이면 voice-answers가 503 STT_UNAVAILABLE을 돌려준다.
STT_PROVIDER=local
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# STT_PROVIDER=openai일 때만 필요.
# OPENAI_API_KEY=sk-your-openai-key-here
# STT_MODEL=whisper-1

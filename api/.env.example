# 음성 답변 키워드 추출 / 추천 이유 생성에 사용.
# 없어도 동작한다(표현 사전 기반 규칙 매칭으로 폴백).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 음성 -> 텍스트 변환 공급자.
#   openai : OPENAI_API_KEY로 Whisper 전사 API 호출 (실제 음성 인식)
#   mock   : 고정 문장 반환. 마이크/과금 없이 세 엔드포인트 흐름을 테스트할 때.
# 미설정이면 voice-answers가 503 STT_UNAVAILABLE을 돌려준다.
STT_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-key-here

# 전사 모델 (기본 whisper-1)
# STT_MODEL=whisper-1

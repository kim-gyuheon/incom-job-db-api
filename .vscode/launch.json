{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: uvicorn (debug)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--host", "0.0.0.0", "--port", "8000"],
            "cwd": "${workspaceFolder}/api",
            "envFile": "${workspaceFolder}/api/.env",
            "justMyCode": true
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/api",
            "envFile": "${workspaceFolder}/api/.env",
            "console": "integratedTerminal"
        }
    ]
}
